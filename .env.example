# --- Sentry ---
# Dejar VACIO fuera de produccion: este DSN queda CONGELADO en el bundle al
# hacer `npm run build`, no hay forma de apagarlo despues para un ambiente
# dado. La unica defensa es no compilarlo con un valor que no sea el de
# produccion.
VITE_SENTRY_DSN_PUBLIC=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
